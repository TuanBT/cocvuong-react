{
  "name": "cocvuong-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "E2E integration tests for Cóc Vương combat system",
  "scripts": {
    "test": "npx tsx test-runner.ts",
    "test:score": "npx tsx test-runner.ts --scenario=score",
    "test:replace": "npx tsx test-runner.ts --scenario=replace",
    "test:arena": "npx tsx test-runner.ts --scenario=arena",
    "test:race": "npx tsx test-runner.ts --scenario=race",
    "test:sync": "npx tsx test-runner.ts --scenario=sync",
    "test:full-small": "npx tsx test-runner.ts --scenario=full-small",
    "test:full-large": "npx tsx test-runner.ts --scenario=full-large",
    "test:full-multi": "npx tsx test-runner.ts --scenario=full-multi",
    "test:parallel": "npx tsx test-runner.ts --scenario=parallel",
    "test:edge": "npx tsx test-runner.ts --scenario=edge",
    "test:full": "npx tsx test-runner.ts --scenario=full-small --scenario=full-large --scenario=full-multi",
    "test:all": "npx tsx test-runner.ts"
  },
  "dependencies": {
    "firebase": "^9.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0"
  }
}
