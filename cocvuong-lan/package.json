{
  "name": "cocvuong-bridge",
  "version": "2.0.0",
  "description": "CocVuong Bridge - Server cho LAN scoring võ thuật",
  "main": "main-combined.js",
  "author": "Bui Tien Tuan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "copy-build": "cp -r ../build ./build",
    "copy-build:win": "xcopy ..\\build .\\build /E /I /Y",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac"
  },
  "dependencies": {
    "qrcode": "^1.5.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.cocvuong.bridge",
    "productName": "CocVuong Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main-combined.js",
      "bridge-server.js",
      "preload.js",
      "preload-online.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
